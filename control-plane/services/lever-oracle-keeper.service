[Unit]
Description=LEVER Oracle Keeper - Price Data Service
Documentation=https://github.com/lever-protocol/lever-protocol
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lever
Group=lever
WorkingDirectory=/home/lever/lever-protocol
Environment=RPC_URL=https://sepolia.base.org
Environment=ORACLE_ADAPTER=0xf0698FCEDD3A212c5f1D78f7c4c008CB90efeA9c
Environment=MARKET_CONFIG=/home/lever/lever-protocol/scripts/oracle/market_config.json
Environment=PUSH_INTERVAL=30
Environment=DRY_RUN=false
ExecStart=/bin/bash -c 'cd /home/lever/lever-protocol/scripts/oracle && source .venv/bin/activate && export KEEPER_KEY=$(cat ../../.env.deployer | tr -d "\\n") && export RPC_URL=https://sepolia.base.org && export ORACLE_ADAPTER=0xf0698FCEDD3A212c5f1D78f7c4c008CB90efeA9c && export PUSH_INTERVAL=30 && export DRY_RUN=false && python3 mock_keeper.py'
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Security settings
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/lever/lever-protocol
PrivateTmp=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lever-oracle-keeper

# Resource limits
LimitNOFILE=65536
LimitCORE=0

[Install]
WantedBy=multi-user.target