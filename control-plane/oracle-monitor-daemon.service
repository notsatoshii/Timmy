[Unit]
Description=LEVER Oracle Monitoring Daemon
After=lever-oracle.service network.target
Wants=lever-oracle.service

[Service]
Type=simple
User=lever
WorkingDirectory=/home/lever/lever-protocol
ExecStart=/home/lever/lever-protocol/control-plane/oracle-watchdog.sh daemon
Restart=always
RestartSec=30
StandardOutput=append:/home/lever/lever-protocol/control-plane/oracle-watchdog.log
StandardError=append:/home/lever/lever-protocol/control-plane/oracle-watchdog.log

# Resource limits
MemoryMax=100M
CPUQuota=10%

[Install]
WantedBy=multi-user.target